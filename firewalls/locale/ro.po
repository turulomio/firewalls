msgstr "Testează conectivitatea firewall-ului pentru conexiuni de intrare și ieșire pe gazde și porturi."

msgid "Target hostname or IP address for outgoing probes (default: kde.org)"
msgstr "Nume gazdă sau adresă IP țintă pentru testele de ieșire (implicit: kde.org)"

msgid "Port to probe (default: 1555)"
msgstr "Portul de testat (implicit: 1555)"

msgid "Transport protocol (tcp or udp, default: tcp)"
msgstr "Protocol de transport (tcp sau udp, implicit: tcp)"

msgid "Maximum socket timeout in seconds (default: 5.0)"
msgstr "Timp maxim de așteptare în secunde (implicit: 5.0)"

msgid "Number of probe attempts to perform (default: 1)"
msgstr "Numărul de încercări de testat (implicit: 1)"

msgid "Run in incoming listen mode (Ingress test) binding local port"
msgstr "Rulare în mod ascultare de intrare (test Ingress) legând portul local"

