msgstr "ИСТОЧНИК"

msgid "Denied INGRESS Traffic Monitor"
msgstr "Монитор заблокированного входящего трафика (INGRESS)"

msgid "BLOCKED INGRESS"
msgstr "ЗАБЛОКИРОВАННЫЙ ВХОДЯЩИЙ (INGRESS)"

