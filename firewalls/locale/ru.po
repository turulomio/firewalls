#, python-brace-format
msgid "FIREWALL DENIAL MONITOR | Started: {start} | Refresh: {interval}s | {dns}"
msgstr "МОНИТОР БЛОКИРОВОК FIREWALL | Запущен: {start} | Обновление: {interval}с | {dns}"

#, python-brace-format
msgid "File: {file} | Last update: {now}"
msgstr "Файл: {file} | Посл. обновление: {now}"

#, python-brace-format
msgid "[ERROR] Log file not found: {file}"
msgstr "[ОШИБКА] Файл журнала не найден: {file}"

msgid "Waiting for log file to be created..."
msgstr "Ожидание создания файла журнала..."

msgid "POS"
msgstr "ПОЗ"

msgid "SOURCE IP / HOSTNAME"
msgstr "IP ИСТОЧНИКА / ИМЯ УЗЛА"

msgid "DESTINATION IP / HOSTNAME"
msgstr "IP НАЗНАЧЕНИЯ / ИМЯ УЗЛА"

msgid "DENIED INCOMING (INGRESS)"
msgstr "ЗАБЛОКИРОВАННЫЕ ВХОДЯЩИЕ (INGRESS)"

#, python-brace-format
msgid "Captured events: {events}"
msgstr "Перехвачено событий: {events}"

msgid "Waiting for denied incoming events..."
msgstr "Ожидание заблокированных входящих событий..."

msgid "DENIED OUTGOING (EGRESS)"
msgstr "ЗАБЛОКИРОВАННЫЕ ИСХОДЯЩИЕ (EGRESS)"

