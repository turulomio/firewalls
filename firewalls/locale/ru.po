msgstr "Остановить системную службу firewalld."

msgid "Machine name or directory path to deploy (e.g., example, /path/to/machine) or 'stop' to stop firewalld"
msgstr "Имя машины или путь к каталогу для развертывания (напр. example, /path/to/machine) или 'stop' для остановки firewalld"

msgid "Directory containing machine configuration folders (overrides FIREWALLS_DIR)"
msgstr "Каталог, содержащий папки конфигураций машин (переопределяет FIREWALLS_DIR)"

msgid "Stop the system firewalld service"
msgstr "Остановить системную службу firewalld"

#, python-brace-format
msgid "Configuration for machine '{machine}' not found."
msgstr "Конфигурация для машины '{machine}' не найдена."

