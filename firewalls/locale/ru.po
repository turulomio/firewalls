msgid "This script must be executed with root privileges."
msgstr "Этот скрипт должен выполняться с привилегиями root."

#, python-brace-format
msgid "rsync synchronization failed with exit code {code}"
msgstr "Синхронизация rsync завершилась с ошибкой с кодом {code}"

#, python-brace-format
msgid "Could not adjust permissions in {path}: {error}"
msgstr "Не удалось настроить права доступа в {path}: {error}"

#, python-brace-format
msgid "Could not verify or create log directory {dir}: {error}"
msgstr "Не удалось проверить или создать каталог журналов {dir}: {error}"

#, python-brace-format
msgid "Configuring conf.d include directive in {conf}..."
msgstr "Настройка директивы включения conf.d в {conf}..."

#, python-brace-format
msgid "Could not update {conf}: {error}"
msgstr "Не удалось обновить {conf}: {error}"

msgid "Managing syslog-ng service with OpenRC..."
msgstr "Управление службой syslog-ng с помощью OpenRC..."

