msgstr "Перезапуск/перезагрузка syslog-ng с помощью OpenRC..."

msgid "Starting syslog-ng service with OpenRC..."
msgstr "Запуск службы syslog-ng с помощью OpenRC..."

msgid "Managing syslog-ng service with systemd..."
msgstr "Управление службой syslog-ng с помощью systemd..."

msgid "Detected sysctl.d configuration. Applying kernel parameters with sysctl..."
msgstr "Обнаружена конфигурация sysctl.d. Применение параметров ядра с помощью sysctl..."

msgid "sysctl parameters applied successfully."
msgstr "Параметры sysctl успешно применены."

#, python-brace-format
msgid "sysctl --system exited with code {code}."
msgstr "Команда sysctl --system завершилась с кодом {code}."

msgid "'sysctl' binary not found in PATH."
msgstr "Исполняемый файл 'sysctl' не найден в PATH."

msgid "'firewall-cmd' is not installed or not found in PATH."
msgstr "'firewall-cmd' не установлен или не найден в PATH."

#, python-brace-format
msgid "On Gentoo Linux, install it with: {cmd}"
msgstr "В Gentoo Linux установите его с помощью: {cmd}"

msgid "Reloading firewalld rules..."
msgstr "Перезагрузка правил firewalld..."

msgid "Configuration reloaded successfully in firewalld."
msgstr "Конфигурация firewalld успешно перезагружена."

msgid "firewalld reload failed. Please check XML configuration files."
msgstr "Сбой перезагрузки firewalld. Пожалуйста, проверьте файлы конфигурации XML."

msgid "firewalld is not running."
msgstr "firewalld не запущен."

msgid "Detected OpenRC. Starting firewalld service..."
msgstr "Обнаружен OpenRC. Запуск службы firewalld..."

msgid "firewalld service started successfully."
msgstr "Служба firewalld успешно запущена."

msgid "Failed to start firewalld service with OpenRC."
msgstr "Не удалось запустить службу firewalld с помощью OpenRC."

msgid "Detected systemd. Starting firewalld service..."
msgstr "Обнаружен systemd. Запуск службы firewalld..."

msgid "Failed to start firewalld service with systemd."
msgstr "Не удалось запустить службу firewalld с помощью systemd."

msgid "Could not determine service manager to start firewalld."
msgstr "Не удалось определить менеджер служб для запуска firewalld."

msgid "Please start the service manually."
msgstr "Пожалуйста, запустите службу вручную."

#, python-brace-format
msgid "Executing post-deployment script ({name})..."
msgstr "Выполнение скрипта после развертывания ({name})..."

msgid "Post-deployment script finished successfully."
msgstr "Скрипт после развертывания успешно завершен."

#, python-brace-format
msgid "Post-deployment script exited with code {code}."
msgstr "Скрипт после развертывания завершился с кодом {code}."

#, python-brace-format
msgid "Error running post-deployment script: {error}"
msgstr "Ошибка при выполнении скрипта после развертывания: {error}"

msgid "Stopping firewalld service"
msgstr "Остановка службы firewalld"

msgid "Running OpenRC: rc-service firewalld stop..."
msgstr "Выполнение OpenRC: rc-service firewalld stop..."

msgid "firewalld service stopped successfully."
msgstr "Служба firewalld успешно остановлена."

msgid "Failed to stop firewalld service with OpenRC."
msgstr "Не удалось остановить службу firewalld с помощью OpenRC."

msgid "Running systemd: systemctl stop firewalld..."
msgstr "Выполнение systemd: systemctl stop firewalld..."

msgid "Failed to stop firewalld service with systemd."
msgstr "Не удалось остановить службу firewalld с помощью systemd."

msgid "Could not determine service manager to stop firewalld."
msgstr "Не удалось определить менеджер служб для остановки firewalld."

msgid "None found"
msgstr "Не найдено"

msgid "Deploy firewalld configuration for a machine on Gentoo Linux and reload or stop the service."
msgstr "Развертывание конфигурации firewalld для машины на Gentoo Linux и перезагрузка или остановка службы."

msgid "Detected machines:"
msgstr "Обнаруженные машины:"

msgid "Search directories:"
msgstr "Каталоги поиска:"

