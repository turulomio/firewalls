msgstr "Развертывание Firewalld (Gentoo) - Машина: {machine}"

#, python-brace-format
msgid "Source Path: {path}"
msgstr "Исходный путь: {path}"

msgid "Deploying configuration files..."
msgstr "Развертывание файлов конфигурации..."

#, python-brace-format
msgid "Source:      {src}/"
msgstr "Источник:    {src}/"

msgid "Destination: /etc/"
msgstr "Назначение:  /etc/"

#, python-brace-format
msgid "File copy error: {error}"
msgstr "Ошибка копирования файлов: {error}"

msgid "Adjusting permissions and directories..."
msgstr "Настройка прав доступа и каталогов..."

#, python-brace-format
msgid "Deployment completed successfully for '{machine}'"
msgstr "Развертывание успешно завершено для '{machine}'"

#, python-brace-format
msgid "Enabling firewalld packet drop logging (LogDenied={mode})..."
msgstr "Включение журналирования сброшенных пакетов firewalld (LogDenied={mode})..."

