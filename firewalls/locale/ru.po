msgstr "Ожидание заблокированных исходящих событий..."

msgid "Real-time live dashboard tallying denied incoming and outgoing connections (IP + port + reverse DNS)."
msgstr "Интерактивная панель в реальном времени, подсчитывающая заблокированные входящие и исходящие соединения (IP + порт + обратный DNS)."

msgid "Refresh interval in seconds (default 3.0)."
msgstr "Интервал обновления в секундах (по умолчанию 3.0)."

msgid "Maximum ranking positions to display per panel (default 20)."
msgstr "Максимальное количество позиций рейтинга для отображения на панели (по умолчанию 20)."

msgid "Count all historical events in the log file instead of starting from zero."
msgstr "Учитывать все исторические события из файла журнала вместо начала с нуля."

msgid "Resolve IP addresses to domain names via reverse DNS PTR (enabled by default)."
msgstr "Разрешать IP-адреса в доменные имена через обратный DNS PTR (включено по умолчанию)."

msgid "Disable reverse DNS resolution (show IP addresses only)."
msgstr "Отключить разрешение обратного DNS (показывать только IP-адреса)."

msgid "Outgoing connection established successfully"
msgstr "Исходящее соединение успешно установлено"

#, python-brace-format
msgid "Connection timed out (Timeout > {timeout}s) - Probable egress firewall drop"
msgstr "Время ожидания соединения истекло (Таймаут > {timeout}с) - Вероятно сброс исходящим фаерволом"

msgid "Connection refused - Port closed on remote destination"
msgstr "В соединении отказано - Порт закрыт на удаленном узле"

#, python-brace-format
msgid "Network error ({error})"
msgstr "Сетевая ошибка ({error})"

msgid "UDP response received from destination"
msgstr "Получен ответ UDP от узла назначения"

#, python-brace-format
msgid "No UDP response (Timeout > {timeout}s) - Port filtered or dropped"
msgstr "Нет ответа UDP (Таймаут > {timeout}с) - Порт фильтруется или сброшен"

#, python-brace-format
msgid "UDP network error ({error})"
msgstr "Сетевая ошибка UDP ({error})"

#, python-brace-format
msgid "Incoming connection received successfully from {host}:{port}"
msgstr "Входящее соединение успешно получено от {host}:{port}"

#, python-brace-format
msgid "No incoming connections within {timeout}s - Probable ingress firewall block"
msgstr "Нет входящих соединений в течение {timeout}с - Вероятно блокировка входящим фаерволом"

#, python-brace-format
msgid "Permission denied binding port {port} (root privileges required for ports < 1024)"
msgstr "Отказано в доступе при привязке порта {port} (для портов < 1024 требуются права root)"

#, python-brace-format
msgid "Local socket error ({error})"
msgstr "Ошибка локального сокета ({error})"

#, python-brace-format
msgid "Incoming UDP packet received successfully from {host}:{port}"
msgstr "Входящий пакет UDP успешно получен от {host}:{port}"

#, python-brace-format
msgid "No incoming UDP packets within {timeout}s - Probable ingress firewall block"
msgstr "Нет входящих пакетов UDP в течение {timeout}с - Вероятно блокировка входящим фаерволом"

msgid "Firewall Ingress Probe (Listen Mode)"
msgstr "Зонд входящего трафика Firewall (Режим прослушивания)"

#, python-brace-format
msgid "Listening: {bind}:{port} ({proto}) | Timeout: {timeout}s"
msgstr "Прослушивание: {bind}:{port} ({proto}) | Таймаут: {timeout}с"

#, python-brace-format
msgid "Waiting for incoming connection [{curr}/{total}]..."
msgstr "Ожидание входящего соединения [{curr}/{total}]..."

#, python-brace-format
msgid "Waiting for incoming connection on port {port}..."
msgstr "Ожидание входящего соединения на порту {port}..."

msgid "PASSED"
msgstr "УСПЕШНО"

msgid "FAILED"
msgstr "НЕУДАЧА"

#, python-brace-format
msgid "Result: [{status}] {msg} ({ms:.1f} ms)"
msgstr "Результат: [{status}] {msg} ({ms:.1f} мс)"

#, python-brace-format
msgid "Summary: {successes}/{count} incoming connections received successfully."
msgstr "Итог: {successes}/{count} входящих соединений успешно получено."

#, python-brace-format
msgid "[ERROR] Could not resolve host: {host}"
msgstr "[ОШИБКА] Не удалось разрешить имя узла: {host}"

msgid "Firewall Egress Probe (Outgoing Mode)"
msgstr "Зонд исходящего трафика Firewall (Исходящий режим)"

#, python-brace-format
msgid "Target: {host} ({ip}):{port} ({proto}) | Timeout: {timeout}s"
msgstr "Цель: {host} ({ip}):{port} ({proto}) | Таймаут: {timeout}с"

#, python-brace-format
msgid "Summary: {successes}/{count} probe attempts succeeded."
msgstr "Итог: {successes}/{count} попыток зондирования завершились успешно."

msgid "Probe firewall connectivity for ingress and egress connections across hosts and ports."
msgstr "Проверка связности межсетевого экрана для входящих и исходящих соединений по узлам и портам."

msgid "Target hostname or IP address for outgoing probes (default: kde.org)"
msgstr "Целевое имя узла или IP-адрес для исходящих зондов (по умолчанию: kde.org)"

msgid "Port to probe (default: 1555)"
msgstr "Порт для проверки (по умолчанию: 1555)"

msgid "Transport protocol (tcp or udp, default: tcp)"
msgstr "Транспортный протокол (tcp или udp, по умолчанию: tcp)"

msgid "Maximum socket timeout in seconds (default: 5.0)"
msgstr "Максимальный таймаут сокета в секундах (по умолчанию: 5.0)"

msgid "Number of probe attempts to perform (default: 1)"
msgstr "Количество выполняемых попыток зондирования (по умолчанию: 1)"

msgid "Run in incoming listen mode (Ingress test) binding local port"
msgstr "Запуск в режиме входящего прослушивания (тест Ingress) с привязкой локального порта"

msgid "Local IP address to bind in listen mode (default: 0.0.0.0)"
msgstr "Локальный IP-адрес для привязки в режиме прослушивания (по умолчанию: 0.0.0.0)"
